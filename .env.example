# Environment Variables
# Copy this file to .env and fill in values

# Server
PORT=3000
NODE_ENV=development

# Supabase (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI Provider — "cohere", "openai", or "zhipu" (default: cohere)
AI_PROVIDER=cohere

# Cohere (free tier, no credit card) — required by default
COHERE_API_KEY=your-cohere-api-key

# Zhipu AI (z.ai / GLM models) — only needed if AI_PROVIDER=zhipu
ZHIPU_API_KEY=your-zhipu-api-key

# OpenAI — only needed if AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key

# Public base URL — used when registering per-integration Telegram webhooks
# Each Telegram integration gets its own webhook URL of form:
#   <PUBLIC_BASE_URL>/api/v1/telegram/webhook/<integrationId>
PUBLIC_BASE_URL=https://your-domain.com

# Bot trigger prefix for questions in group chats
BOT_TRIGGER=@orgbrain

# AES-256-GCM key for encrypting per-integration bot tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# Linear OAuth app. Register at https://linear.app/settings/api/applications
# to get a client ID + secret. Redirect URI must match exactly.
# Leave all three blank if not using Linear.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_REDIRECT_URI=https://your-domain.com/api/v1/linear/callback

# Vertex AI — used as the small classifier model (Gemini 2.5 Flash-Lite) for
# aggregation queries ("how many open tickets", "oldest ticket", etc).
#
# Auth: set GCP_SERVICE_ACCOUNT_KEY_B64 to the base64-encoded contents of a
# service-account JSON key. The service account needs the "Vertex AI User"
# role on VERTEX_AI_PROJECT_ID.
#
# How to encode your key:
#   base64 -w0 service-account.json   # Linux
#   base64 -i service-account.json    # macOS
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))  # PowerShell
#
# Leave VERTEX_AI_PROJECT_ID unset to disable aggregation classification; the
# system falls through to semantic search.
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_CLASSIFIER_MODEL=gemini-2.5-flash-lite
GCP_SERVICE_ACCOUNT_KEY_B64=
