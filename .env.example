# Environment Variables
# Copy this file to .env and fill in values

# Server
PORT=3000
NODE_ENV=development

# Supabase (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI Provider — "cohere", "openai", or "zhipu" (default: cohere)
AI_PROVIDER=cohere

# Cohere (free tier, no credit card) — required by default
COHERE_API_KEY=your-cohere-api-key

# Zhipu AI (z.ai / GLM models) — only needed if AI_PROVIDER=zhipu
ZHIPU_API_KEY=your-zhipu-api-key

# OpenAI — only needed if AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# Bot Config
BOT_USERNAME=orgbrain_bot
BOT_TRIGGER=@orgbrain
